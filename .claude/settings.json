{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(bash scripts/scrub.sh)",
      "Bash(bash scripts/setup.sh --check)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo 'Jarvis Product Developer'"
  }
}
